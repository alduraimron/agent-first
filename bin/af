#!/usr/bin/env python3
"""Activate only the personal OMP profile and launch the native CLI."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
PROFILE = "agent-first"
ASSETS = ("config.yml", "APPEND_SYSTEM.md", "RULES.md", "agents", "skills")


def profile_directory():
    config_name = os.environ.get("PI_CONFIG_DIR") or ".omp"
    if config_name != ".omp":
        raise ValueError("PI_CONFIG_DIR must be unset or .omp; custom roots are not activated implicitly")
    return Path.home() / ".omp" / "profiles" / PROFILE / "agent"


def activate():
    destination = profile_directory()
    if destination.parent.is_symlink() or destination.is_symlink():
        raise ValueError(f"Refusing a redirected named-profile directory: {destination}")
    for name in ("tools", "mcp.json", ".mcp.json"):
        target = destination / name
        if os.path.lexists(target) and (not target.is_dir() or any(target.iterdir())):
            raise ValueError(f"Unexpected executable configuration in personal profile: {target}")
    for name in ASSETS:
        source = ROOT / "profile" / name
        target = destination / name
        if not source.exists():
            raise ValueError(f"Missing profile asset: {source}")
        if os.path.lexists(target) and (not target.is_symlink() or target.resolve() != source.resolve()):
            raise ValueError(f"Refusing to overwrite existing profile entry: {target}")
    destination.mkdir(parents=True, exist_ok=True, mode=0o700)
    for name in ASSETS:
        target = destination / name
        try:
            target.symlink_to(ROOT / "profile" / name, target_is_directory=(ROOT / "profile" / name).is_dir())
        except FileExistsError:
            if not target.is_symlink() or target.resolve() != (ROOT / "profile" / name).resolve():
                raise ValueError(f"Profile entry changed during activation: {target}") from None
    return destination


def setup():
    """Link this launcher, never a bare profile alias, into the user's PATH."""
    source = ROOT / "bin" / "af"
    target = Path.home() / ".local" / "bin" / "af"
    if os.path.lexists(target) and (not target.is_symlink() or target.resolve() != source):
        raise ValueError(f"Refusing to replace an existing command: {target}")
    found = shutil.which("af")
    if found and Path(found).resolve() != source:
        raise ValueError(f"Another af command is on PATH: {found}; resolve that conflict first")
    activate()
    target.parent.mkdir(parents=True, exist_ok=True)
    try:
        target.symlink_to(source)
    except FileExistsError:
        if not target.is_symlink() or target.resolve() != source:
            raise ValueError(f"Command changed during setup: {target}") from None
    print(f"Installed {target}")
    if shutil.which("af") is None:
        print('Add ~/.local/bin to your shell PATH: export PATH="$HOME/.local/bin:$PATH"', file=sys.stderr)


def check_project(directory):
    """Reject native sources that can add tools or shadow the advisory agents."""
    if not directory.is_dir():
        raise ValueError(f"Project directory does not exist: {directory}")
    tools = directory / ".omp" / "tools"
    if tools.exists() and (not tools.is_dir() or any(tools.iterdir())):
        raise ValueError(f"Native project tools are outside the personal profile trust boundary: {tools}")
    home = Path.home().resolve()
    for ancestor in (directory, *directory.parents):
        agents = ancestor / ".omp" / "agents"
        if agents.is_dir() and any(agents.glob("*.md")):
            raise ValueError(f"Native project agents can shadow profile agents; use a clean personal project: {agents}")
        if ancestor == home:
            break


def project_boundary(directory):
    # Never inherit approval across a nested Git repository.
    return next((parent for parent in (directory, *directory.parents)
                 if os.path.lexists(parent / ".git")), directory)


def project_identity(directory):
    root = project_boundary(directory)
    info = root.stat()
    identity = {"root": str(root), "directory": [info.st_dev, info.st_ino]}
    if not os.path.lexists(root / ".git"):
        return identity
    git = shutil.which("git")
    if git is None:
        raise ValueError("Git is required to identify this repository; nothing will be installed")
    environment = launch_environment()
    environment["GIT_OPTIONAL_LOCKS"] = "0"
    location = subprocess.run(
        [git, "-C", str(directory), "rev-parse", "--show-toplevel", "--absolute-git-dir"],
        env=environment, capture_output=True, text=True, timeout=10)
    lines = location.stdout.splitlines()
    if location.returncode or len(lines) != 2 or Path(lines[0]).resolve() != root:
        raise ValueError("Cannot identify a Git worktree within the selected project")
    git_directory = Path(lines[1]).resolve()
    git_info = git_directory.stat()
    remotes = subprocess.run(
        [git, "-C", str(root), "config", "--local", "--no-includes", "--null",
         "--get-regexp", r"^remote\..*\.(url|pushurl)$"],
        env=environment, capture_output=True, timeout=10)
    if remotes.returncode not in (0, 1):
        raise ValueError("Cannot read this project's Git remote identity")
    identity.update(git_directory=str(git_directory),
                    git_identity=[git_info.st_dev, git_info.st_ino],
                    remotes=hashlib.sha256(remotes.stdout).hexdigest())
    return identity


def personal_record(root):
    parent = Path.home() / ".config" / "agent-first" / "projects"
    record = parent / (hashlib.sha256(str(root).encode()).hexdigest() + ".json")
    if parent.is_symlink() or record.is_symlink():
        raise ValueError(f"Refusing redirected personal-project approval: {record}")
    return record


def is_personal(identity):
    record = personal_record(identity["root"])
    try:
        return json.loads(record.read_text()) == identity
    except FileNotFoundError:
        return False
    except ValueError:
        raise ValueError(f"Invalid personal-project approval; review {record}") from None


def trust_project(identity):
    record = personal_record(identity["root"])
    record.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor, temporary = tempfile.mkstemp(prefix=".approval-", dir=record.parent)
    temporary = Path(temporary)
    try:
        with os.fdopen(descriptor, "w") as stream:
            json.dump(identity, stream, indent=2)
            stream.write("\n")
        os.replace(temporary, record)
    finally:
        temporary.unlink(missing_ok=True)


def require_personal(directory):
    identity = project_identity(directory)
    if is_personal(identity):
        return
    if not sys.stdin.isatty():
        raise ValueError("Project is not approved as personal. An operator must run "
                         "af --cwd PATH --trust-project for this personal project first")
    print("Unapproved or changed project: " + json.dumps(identity["root"]), file=sys.stderr)
    print("Use Agent-First in this PERSONAL project (never a team/production repo)? [y/N] ",
          end="", file=sys.stderr, flush=True)
    try:
        approved = sys.stdin.readline().strip().lower() in ("y", "yes")
    except KeyboardInterrupt:
        approved = False
        print(file=sys.stderr)
    if not approved:
        raise ValueError("Personal-project approval declined; OMP was not started")
    trust_project(identity)


def launch_environment():
    environment = os.environ.copy()
    for name in ("PI_CONFIG_FILES", "PI_CODING_AGENT_DIR", "PI_SESSION_ID",
                 "PI_SESSION_FILE", "PI_TOOL_CALL_ID", "GIT_DIR", "GIT_WORK_TREE",
                 "GIT_COMMON_DIR", "GIT_INDEX_FILE"):
        environment.pop(name, None)
    environment["OMP_PROFILE"] = PROFILE
    environment["PI_PROFILE"] = PROFILE
    return environment


def configured_default(executable, directory):
    """Read native role metadata only, not the default profile's other settings."""
    environment = launch_environment()
    for profile in (PROFILE, None):
        command = [executable, "--cwd", str(directory)]
        if profile:
            command.extend(("--profile", PROFILE, "--config", str(ROOT / "profile/config.yml")))
        else:
            environment.pop("OMP_PROFILE", None)
            environment.pop("PI_PROFILE", None)
        command.extend(("config", "get", "modelRoles", "--json"))
        response = subprocess.run(command, env=environment, capture_output=True, text=True, timeout=20)
        if response.returncode:
            raise ValueError("Cannot read native OMP model roles; inspect omp config get modelRoles --json")
        roles = json.loads(response.stdout).get("value")
        if not isinstance(roles, dict):
            raise ValueError("Native OMP modelRoles must be an object")
        model = roles.get("default")
        if model is not None:
            if not isinstance(model, str) or not model.strip() or model.lstrip().startswith("-"):
                raise ValueError("Native OMP default model role must be a nonempty model selector")
            return model.strip()
    raise ValueError("No default model is configured in OMP; configure its default role or use --model")


def positive_cost(value):
    number = float(value)
    if not 0 < number < float("inf"):
        raise argparse.ArgumentTypeError("cost must be a finite positive number")
    return number


def arguments():
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    management = parser.add_mutually_exclusive_group()
    management.add_argument("--setup", action="store_true", help="link ~/.local/bin/af and register the named profile")
    management.add_argument("--activate", action="store_true", help="register profile links without starting a model session")
    management.add_argument("--trust-project", action="store_true", help="explicitly enroll this personal project, without launching OMP")
    management.add_argument("--untrust-project", action="store_true", help="forget this project's personal approval")
    parser.add_argument("--cwd", type=Path, default=Path.cwd(), help="project directory (default: current working directory)")
    parser.add_argument("--model", help="override the configured native OMP default model")
    parser.add_argument("--print", dest="print_mode", action="store_true", help="one-shot Controlled YOLO run; explicit prompts still fail closed without UI")
    parser.add_argument("--json", action="store_true", help="native print-mode JSON events")
    parser.add_argument("--max-cost", type=positive_cost, help="stop sending requests at this USD cost")
    parser.add_argument("--max-time", help="native OMP duration limit, for example 5m")
    history = parser.add_mutually_exclusive_group()
    history.add_argument("--continue", dest="continue_session", action="store_true")
    history.add_argument("--resume", metavar="SESSION", help="session ID or path from the personal profile")
    parser.add_argument("prompt", nargs="*", help="ordinary task prompt; use -- before text starting with a dash")
    result = parser.parse_args()
    if any((result.activate, result.setup, result.trust_project, result.untrust_project)) and (
            result.prompt or result.print_mode or result.json or result.continue_session or result.resume):
        parser.error("setup, activation and project enrollment cannot start or resume a session")
    return result


def main():
    args = arguments()
    try:
        executable = shutil.which("omp")
        if executable is None:
            raise ValueError("omp is not on PATH; this launcher does not install it")
        directory = args.cwd.expanduser().resolve()
        if not directory.is_dir():
            raise ValueError(f"Project directory does not exist: {directory}")
        profile_directory()
        if args.setup:
            setup()
            return 0
        if args.untrust_project:
            personal_record(project_boundary(directory)).unlink(missing_ok=True)
            print(f"Forgot personal approval for {project_boundary(directory)}")
            return 0
        check_project(directory)
        if args.activate:
            print(activate())
            return 0
        if args.trust_project:
            identity = project_identity(directory)
            trust_project(identity)
            print(f"Approved personal project {identity['root']}")
            return 0
        require_personal(directory)
        if not sys.stdin.isatty() and not args.prompt and not args.continue_session and not args.resume:
            raise ValueError("Non-interactive launches require an explicit prompt; stdin is not read implicitly")
        destination = activate()
        command = [
            executable, "--profile", PROFILE, "launch",
            "--cwd", str(directory),
            "--config", str(ROOT / "profile" / "config.yml"),
            "--append-system-prompt", str(ROOT / "profile" / "APPEND_SYSTEM.md"),
            "--no-extensions", "--no-title",
        ]
        model = args.model
        if model is None and not args.continue_session and not args.resume:
            model = configured_default(executable, directory)
        if model is not None:
            command.extend(("--model", model))
        if args.max_cost is not None:
            command.extend(("--max-cost", str(args.max_cost)))
        if args.max_time:
            command.extend(("--max-time", args.max_time))
        if args.continue_session:
            command.append("--continue")
        if args.resume:
            session = Path(args.resume).expanduser()
            if "/" in args.resume or "\\" in args.resume or session.is_file():
                if not session.is_file() or not session.resolve().is_relative_to(destination.resolve()):
                    raise ValueError("Resume paths must be existing files in the agent-first profile")
            command.extend(("--resume", args.resume))
        if args.print_mode or args.json:
            command.extend(("--print", "--wait-async"))
        if args.json:
            command.extend(("--mode", "json"))
        if args.prompt:
            command.extend(("--", " ".join(args.prompt)))
        environment = launch_environment()
        os.execve(executable, command, environment)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"af: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
